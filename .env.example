# Your OpenAI API key — get one from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-api-key-here
# Base URL for the OpenAI API (can be changed for proxies or compatible APIs)
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# The model to use for transcription and review (e.g., gpt-4o, gemini-2.0-flash)
MODEL_NAME=gemini-3.1-flash-lite

# The Google Drive folder ID containing exported GoodNotes PDFs
# Find this in the URL of your Drive folder: https://drive.google.com/drive/folders/<FOLDER_ID>
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id

# Absolute path to your Obsidian vault
OBSIDIAN_VAULT_PATH=~/Library/Mobile Documents/iCloud~md~obsidian/Documents/Waves in Waves

# Directory where downloaded PDFs are placed (relative or absolute)
NOTES_DIR=./Notes

# Chunking (optional — defaults: 1 page/chunk, 15s delay)
# PAGES_PER_CHUNK=1
# REQUEST_DELAY_SECONDS=15
